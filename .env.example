# CLAIR PRO — paths and runtime settings (copy to .env and adjust)

# Host path to the IMMUTABLE CLAIR Base directory
# Windows example: CLAIR_PILOT_DIR=c:\Clair_pilot
CLAIR_PILOT_DIR=./clair-base

# Command to start CLAIR Base inside its container (run in /clair-base)
CLAIR_BASE_CMD=npm start

# Upstream LLM (OpenAI-compatible). Demo example:
#   LLM_PROVIDER_URL=http://llm-mock:4100  (then run: docker compose --profile demo up)
LLM_PROVIDER_URL=https://api.openai.com
LLM_API_KEY=
